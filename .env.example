# ---- Backend ----
# Google Places API (New) anahtarı — alma adımları README'de.
# Boş bırakılırsa arayüz uyarı gösterir, /api/scan 503 döner.
GOOGLE_PLACES_API_KEY=

# Frontend'in backend'e erişiminde izin verilen kökenler (virgülle ayrılır).
# Not: Next.js dev'de /api isteklerini backend'e proxy'ler; bu yalnızca
# doğrudan erişimler için gereklidir.
CORS_ORIGINS=http://localhost:3000

# Tek taramada en fazla kaç Places çağrısı yapılsın (maliyet üst sınırı).
# 1 tür-filtresiz + (PLACES_MAX_CALLS-1) tür grubu; her çağrı en fazla 20 işletme döner.
PLACES_MAX_CALLS=9

# Taramada web sitesi incelenecek en fazla işletme.
WEBSITE_CHECK_LIMIT=60
WEBSITE_CHECK_TIMEOUT=10
WEBSITE_CHECK_WORKERS=10

# ---- E-posta gönderimi (SMTP) ----
# SMTP_HOST boşsa /api/email/send 503 döner; arayüzde Gönder çalışmaz.
# Gmail için: smtp.gmail.com:587 + hesap şifresi DEĞİL "uygulama şifresi".
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Gönderen adresi; boşsa SMTP_USERNAME kullanılır.
SMTP_FROM=
# 587 → STARTTLS; 465 → SMTP_SSL (bu bayrak yok sayılır).
SMTP_TLS=true
SMTP_TIMEOUT=15

# E-posta kazıma (modal açılınca site taranır): istek başına en fazla site.
EMAIL_DISCOVER_MAX_SITES=20
EMAIL_DISCOVER_WORKERS=5

# ---- Frontend ----
WEB_PORT=3000

# PostgreSQL bağlantı dizesi — doluysa tüm kalıcı veri burada tutulur.
# Docker'da compose tarafından db servisine ayarlanır; boş bırakılırsa
# yerel geliştirme/testler SQLite kullanır.
DATABASE_URL=

# Docker'daki Postgres servisinin parolası (docker-compose.yml kullanır).
POSTGRES_PASSWORD=radar

# Tarama geçmişinin tutulduğu SQLite dosyası (boş = <proje kökü>/data/scans.db).
# Docker'da /data/scans.db olarak ayarlanır (bkz. docker-compose.yml).
DB_PATH=

# ---- Auth ----
# İlk açılışta kullanıcı yoksa varsayılan admin/admin hesabı oluşur.

# Oturum cookie'si geçerlilik süresi (gün).
SESSION_TTL_DAYS=30
