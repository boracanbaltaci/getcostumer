# =====================================================================
# Ankara Business Radar – ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
# .env dosyasını ASLA sürüm kontrolüne eklemeyin.
# =====================================================================

# --- Genel ---
ENVIRONMENT=production
TIMEZONE=Europe/Istanbul
TARGET_PROVINCE=ANKARA
WEB_PORT=3000

# --- Güvenlik (zorunlu: uzun ve rastgele bir değer üretin) ---
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000
# İlk açılışta oluşturulacak yönetici (oluşturduktan sonra parolayı arayüzden değiştirin)
FIRST_ADMIN_EMAIL=admin@firmaniz.com.tr
FIRST_ADMIN_PASSWORD=

# --- Veritabanı ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=radar
# Docker dışında çalıştırırken:
# DATABASE_URL=postgresql+psycopg://radar:change-me-db@localhost:5432/radar
# REDIS_URL=redis://localhost:6379/0

# --- Günlük otomasyon ---
DAILY_SCAN_HOUR=8
DAILY_SCAN_MINUTE=30
INITIAL_BACKFILL_DAYS=30

# --- TTSG Veri Aboneliği (TOBB) – Web Servis ---
# Abonelik sözleşmesi sonrası TOBB'un verdiği bilgilerle doldurun.
TTSG_WS_ENABLED=false
TTSG_WS_BASE_URL=
TTSG_WS_USERNAME=
TTSG_WS_PASSWORD=
TTSG_WS_TOKEN=
# Teknik dokümana göre alan eşlemesi (JSON). Örnek:
# TTSG_WS_FIELD_MAP={"path":"/ilanlar?yayinTarihi={date}","items_key":"ilanlar","fields":{"trade_name":"Unvan1","mersis_no":"MersisNo"}}
TTSG_WS_FIELD_MAP=

# --- Lisanslı ticari veri sağlayıcı (isteğe bağlı) ---
LICENSED_FEED_ENABLED=false
LICENSED_FEED_URL=
LICENSED_FEED_API_KEY=
LICENSED_FEED_FORMAT=json
LICENSED_FEED_FIELD_MAP=

# --- İletişim bilgisi araştırma ---
ENRICHMENT_ENABLED=true
ENRICHMENT_USER_AGENT=AnkaraBusinessRadar/1.0 (+kurumsal iletisim arastirmasi; robots.txt'e uyar; iletisim: bilgi@firmaniz.com.tr)
ENRICHMENT_DOMAIN_PROBE=true
# OpenStreetMap Nominatim (ODbL; saniyede en fazla 1 istek – kullanım politikasına uyun)
OSM_NOMINATIM_ENABLED=false
OSM_CONTACT_EMAIL=
# Brave Search API (https://brave.com/search/api/) – aday web sitesi bulma
BRAVE_SEARCH_API_KEY=
# Google Places API (New) – yalnızca place_id saklanır, ayrıntılar canlı gösterilir
GOOGLE_PLACES_API_KEY=
# Mobil numaralar kişisel veri olabilir; hukuki değerlendirme yapmadan açmayın
STORE_MOBILE_NUMBERS=false

# --- Yapay zekâ (isteğe bağlı; yoksa kural tabanlı motor çalışır) ---
LLM_PROVIDER=none
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_REFUSAL_FALLBACK=true

# --- Ekip içi bildirimler (isteğe bağlı) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
NOTIFY_EMAILS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- KVKK saklama süreleri (gün) ---
RETENTION_DAYS_UNCONTACTED=365
RETENTION_DAYS_LOST=730

# --- Teklif PDF başlığı ---
COMPANY_NAME_FOR_QUOTES=Firma Adınız
COMPANY_INFO_FOR_QUOTES=Adres · Telefon · E-posta · Vergi Dairesi/No
